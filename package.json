{
  "name": "dsh-notion-local-tools",
  "version": "0.2.1",
  "description": "DSH local file tools for a user-configured notion2api endpoint",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./adapter": "./adapter.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "adapter.mjs",
    "index.mjs",
    "launch.mjs",
    "cordis.patch.yml",
    "server"
  ],
  "bin": {
    "dsh-notion-local-tools": "./launch.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check adapter.mjs && node --check index.mjs && node --check launch.mjs && npm test"
  },
  "engines": {
    "node": ">=22.22.0",
    "dsh": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notion2api",
    "local-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7827666/dsh-notion-local-tools.git"
  },
  "bugs": {
    "url": "https://github.com/7827666/dsh-notion-local-tools/issues"
  },
  "homepage": "https://github.com/7827666/dsh-notion-local-tools#readme",
  "license": "MIT"
}
